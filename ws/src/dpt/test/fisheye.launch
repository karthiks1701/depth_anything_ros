<launch>
  <arg name="input_image" default="/usb_cam/image_rect"/>
  <arg name="input_depth" default="/depth_anything/depth_registered/image_rect"/>
  <arg name="output_cloud" default="/depth_anything/depth_registered/points" />
  <arg name="camera_info" default="/usb_cam/camera_info_rect"/>
  <arg name="model" default="vits"/>
  <arg name="scale" default="0.6" />
  <arg name="depth_scale" default="0.8"/>
  <rosparam file="/dpt_ros/ws/src/dpt/test/image_undistort.yaml" command="load"/>
  <arg name="input_camera_name" default="usb_cam" />

  <node name="usb_cam" pkg="usb_cam" type="usb_cam_node" output="screen" >
    <param name="video_device" value="/dev/video0" />
    <param name="image_width" value="640" />
    <param name="image_height" value="480" />
    <param name="pixel_format" value="yuyv" />
    <param name="color_format" value="yuv422p" />
    <param name="camera_frame_id" value="usb_cam_link" />
    <param name="camera_name" value="usb_cam" />
    <param name="io_method" value="mmap"/>
  </node>

  <!-- <node pkg="dpt" type="fisheye_pointcloud.py" name="fisheye_pointcloud" output="screen">
        <param name="rgb_topic" value="/usb_cam/image_raw"/>
        <param name="depth_topic" value="/depth_anything/depth_registered/image_rect"/>
        <param name="camera_info_topic" value="/usb_cam/camera_info"/>
        <param name="pointcloud_topic" value="/usb_cam/pointcloud"/>
  </node> -->

  <node pkg="dpt" type="fisheye_rectifier.py" name="fisheye_rectifier" output="screen">
    <param name="image_topic" value="/usb_cam/image_raw"/>
    <param name="camera_info_topic" value="/usb_cam/camera_info"/>
    <param name="output_image_topic" value="/usb_cam/image_rect"/>
    <param name="output_camera_info_topic" value="/usb_cam/camera_info_rect"/>
    <param name="width" value="640"/>
    <param name="height" value="480"/>
    <param name="balance" value="0.0"/>
    <param name="fov_scale" value="0.6"/>
  </node> 
  
  <!-- <group ns="usb_cam">
    <node name="image_proc" pkg="image_proc" type="image_proc" output="screen"/>
  </group> -->


    <!-- <node name="image_undistort" pkg="image_undistort" type="image_undistort_node" output="screen">
      <param name="input_camera_info_from_ros_params" value="true"/>
      <param name="input_camera_namespace" value="/usb_cam"/>
      <param name="publish_tf" value="false"/>
      <param name="scale" value="1.0"/>
      <param name="output_camera_info_source" value="auto_generated"/>
      <remap from="input/image" to="/usb_cam/image_raw"/>
    </node> -->


  <!-- <node name="usb_cam_image_undistort" pkg="image_undistort" type="image_undistort_node" output="screen">
    <param name="input_camera_namespace" value="/usb_cam"/>
    <param name="input_camera_info_from_ros_params" value="true"/>
    <param name="scale" value="1.0"/>
    <param name="output_camera_info_source" value="auto_generated"/>
    <remap from="input/image" to="/usb_cam/image_raw"/>
    <remap from="input/camera_info" to="/usb_cam/camera_info"/>
    <remap from="output/image" to="/usb_cam/image_undistorted"/>
    <remap from="output/camera_info" to="/usb_cam/camera_info_undistorted"/>
  </node> -->



  <include file="$(find dpt)/launch/depth_estimation.launch" >
    <arg name="model" value="$(arg model)"/>
    <arg name="input_image" value="$(arg input_image)"/>
    <arg name="input_depth" value="$(arg input_depth)"/>
    <arg name="output_cloud" value="$(arg output_cloud)" />
    <arg name="camera_info" value="$(arg camera_info)"/>
    <arg name="depth_scale" value="$(arg depth_scale)"/>
  </include>

</launch>
